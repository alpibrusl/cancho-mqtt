{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alpibrusl/cancho-mqtt/schemas/mqtt.v1.json",
  "title": "mqtt.v1",
  "description": "One line of the NDJSON stream `mqtt` writes. The last line of a stream that finished is the end record; a stream without one was cut short.",
  "oneOf": [
    {
      "$ref": "#/$defs/listening"
    },
    {
      "$ref": "#/$defs/refusal"
    },
    {
      "$ref": "#/$defs/stats"
    },
    {
      "$ref": "#/$defs/rule"
    },
    {
      "$ref": "#/$defs/error_record"
    },
    {
      "$ref": "#/$defs/end"
    }
  ],
  "$defs": {
    "text_or_bytes": {
      "description": "UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "required": [
            "b64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "repair": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "retry"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "argv"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "choose"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "argv"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "options"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "GENERAL_ERROR",
            "INVALID_ARGS",
            "NOT_FOUND",
            "PERMISSION_DENIED",
            "CONFLICT",
            "PRECONDITION_FAILED"
          ]
        },
        "rule": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9-]+$"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "repair": {
          "$ref": "#/$defs/repair"
        },
        "detail": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "rule",
        "message",
        "hint",
        "repair",
        "detail"
      ],
      "additionalProperties": false
    },
    "listening": {
      "type": "object",
      "properties": {
        "type": {
          "const": "listening"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "max_connections": {
          "type": "integer",
          "minimum": 0
        },
        "max_packet": {
          "type": "integer",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "port",
        "max_connections",
        "max_packet",
        "memory_bytes",
        "t_ms"
      ],
      "additionalProperties": false
    },
    "refusal": {
      "type": "object",
      "properties": {
        "type": {
          "const": "refusal"
        },
        "rule": {
          "enum": [
            "protocol.connect-first",
            "protocol.connect-twice",
            "timeout.connect",
            "protocol.bad-name",
            "protocol.unsupported-level",
            "protocol.client-id-rejected",
            "protocol.reserved-flags",
            "protocol.remaining-length",
            "limit.packet-size",
            "protocol.malformed-packet",
            "protocol.topic-invalid",
            "protocol.filter-invalid",
            "protocol.packet-id",
            "protocol.qos3",
            "limit.subscriptions-per-client",
            "limit.subscriptions-total",
            "limit.connections",
            "timeout.keepalive",
            "timeout.write-stalled",
            "limit.queue",
            "limit.retained",
            "limit.offline-sessions",
            "protocol.unexpected-packet",
            "limit.topic-level",
            "limit.will-size",
            "limit.output-full",
            "limit.qos2-inbound",
            "protocol.reserved-topic"
          ]
        },
        "connection": {
          "type": "integer"
        },
        "client_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text_or_bytes"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "rule",
        "connection",
        "client_id",
        "truncated",
        "t_ms",
        "suppressed"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "type": {
          "const": "stats"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "connections": {
          "type": "integer",
          "minimum": 0
        },
        "sessions_online": {
          "type": "integer",
          "minimum": 0
        },
        "sessions_offline": {
          "type": "integer",
          "minimum": 0
        },
        "subscriptions": {
          "type": "integer",
          "minimum": 0
        },
        "retained": {
          "type": "integer",
          "minimum": 0
        },
        "publishes": {
          "type": "integer",
          "minimum": 0
        },
        "delivered": {
          "type": "integer",
          "minimum": 0
        },
        "connects": {
          "type": "integer",
          "minimum": 0
        },
        "disconnects": {
          "type": "integer",
          "minimum": 0
        },
        "retained_sent": {
          "type": "integer",
          "minimum": 0
        },
        "offline_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "takeovers": {
          "type": "integer",
          "minimum": 0
        },
        "refusals": {
          "type": "object",
          "properties": {
            "protocol.connect-first": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.connect-twice": {
              "type": "integer",
              "minimum": 0
            },
            "timeout.connect": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.bad-name": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.unsupported-level": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.client-id-rejected": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.reserved-flags": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.remaining-length": {
              "type": "integer",
              "minimum": 0
            },
            "limit.packet-size": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.malformed-packet": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.topic-invalid": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.filter-invalid": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.packet-id": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.qos3": {
              "type": "integer",
              "minimum": 0
            },
            "limit.subscriptions-per-client": {
              "type": "integer",
              "minimum": 0
            },
            "limit.subscriptions-total": {
              "type": "integer",
              "minimum": 0
            },
            "limit.connections": {
              "type": "integer",
              "minimum": 0
            },
            "timeout.keepalive": {
              "type": "integer",
              "minimum": 0
            },
            "timeout.write-stalled": {
              "type": "integer",
              "minimum": 0
            },
            "limit.queue": {
              "type": "integer",
              "minimum": 0
            },
            "limit.retained": {
              "type": "integer",
              "minimum": 0
            },
            "limit.offline-sessions": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.unexpected-packet": {
              "type": "integer",
              "minimum": 0
            },
            "limit.topic-level": {
              "type": "integer",
              "minimum": 0
            },
            "limit.will-size": {
              "type": "integer",
              "minimum": 0
            },
            "limit.output-full": {
              "type": "integer",
              "minimum": 0
            },
            "limit.qos2-inbound": {
              "type": "integer",
              "minimum": 0
            },
            "protocol.reserved-topic": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "protocol.connect-first",
            "protocol.connect-twice",
            "timeout.connect",
            "protocol.bad-name",
            "protocol.unsupported-level",
            "protocol.client-id-rejected",
            "protocol.reserved-flags",
            "protocol.remaining-length",
            "limit.packet-size",
            "protocol.malformed-packet",
            "protocol.topic-invalid",
            "protocol.filter-invalid",
            "protocol.packet-id",
            "protocol.qos3",
            "limit.subscriptions-per-client",
            "limit.subscriptions-total",
            "limit.connections",
            "timeout.keepalive",
            "timeout.write-stalled",
            "limit.queue",
            "limit.retained",
            "limit.offline-sessions",
            "protocol.unexpected-packet",
            "limit.topic-level",
            "limit.will-size",
            "limit.output-full",
            "limit.qos2-inbound",
            "protocol.reserved-topic"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "t_ms",
        "connections",
        "sessions_online",
        "sessions_offline",
        "subscriptions",
        "retained",
        "publishes",
        "delivered",
        "connects",
        "disconnects",
        "retained_sent",
        "offline_dropped",
        "takeovers",
        "refusals"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "type": {
          "const": "rule"
        },
        "tag": {
          "enum": [
            "protocol.connect-first",
            "protocol.connect-twice",
            "timeout.connect",
            "protocol.bad-name",
            "protocol.unsupported-level",
            "protocol.client-id-rejected",
            "protocol.reserved-flags",
            "protocol.remaining-length",
            "limit.packet-size",
            "protocol.malformed-packet",
            "protocol.topic-invalid",
            "protocol.filter-invalid",
            "protocol.packet-id",
            "protocol.qos3",
            "limit.subscriptions-per-client",
            "limit.subscriptions-total",
            "limit.connections",
            "timeout.keepalive",
            "timeout.write-stalled",
            "limit.queue",
            "limit.retained",
            "limit.offline-sessions",
            "protocol.unexpected-packet",
            "limit.topic-level",
            "limit.will-size",
            "limit.output-full",
            "limit.qos2-inbound",
            "protocol.reserved-topic"
          ]
        },
        "action": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "tag",
        "action"
      ],
      "additionalProperties": false
    },
    "error_record": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "type",
        "error"
      ],
      "additionalProperties": false
    },
    "end": {
      "type": "object",
      "properties": {
        "type": {
          "const": "end"
        },
        "ok": {
          "type": "boolean"
        },
        "command": {
          "const": "mqtt"
        },
        "schema": {
          "const": "mqtt.v1"
        },
        "complete": {
          "type": "boolean"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "publishes": {
          "type": "integer",
          "minimum": 0
        },
        "delivered": {
          "type": "integer",
          "minimum": 0
        },
        "connects": {
          "type": "integer",
          "minimum": 0
        },
        "disconnects": {
          "type": "integer",
          "minimum": 0
        },
        "retained_sent": {
          "type": "integer",
          "minimum": 0
        },
        "offline_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "takeovers": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "ok",
        "command",
        "schema",
        "complete"
      ],
      "additionalProperties": false
    }
  }
}
