edition 5;

module mqtt.auth;

import std.hmac;

// `mqtt.auth` -- password hashing for the broker's credential table (design section 7c).
//
// PBKDF2 (RFC 8018 section 5.2) over HMAC-SHA-256, one output block of 32 bytes. `std.hmac` supplies the HMAC; the loop is
// here because `std` has none. The keyed state is built once and copied for every iteration, so an iteration is one
// copy, one update and one final, not a key setup.

pub fn hash_len() -> [] int {
    return 32;
}

// dk[0..32] = PBKDF2-HMAC-SHA256(password, salt, iterations). Answers 0, or -1 when `iterations` is below 1 or `dk` is
// shorter than 32 bytes.
pub fn pbkdf2_sha256[&p, &s, &d](password: &p [byte], salt: &s [byte], iterations: int, dk: &!d [byte]) -> [] int {
    if iterations < 1 || len(dk) < 32 {
        return -1;
    }
    let n = hmac.state_len(32);
    region r {
        let base = alloc_slice[r](n, 0);
        let work = alloc_slice[r](n, 0);
        hmac.init(32, base, password);
        let one = alloc_slice[r](4, byte_of(0));
        one[3] = byte_of(1);
        let u = alloc_slice[r](32, byte_of(0));
        let acc = alloc_slice[r](32, byte_of(0));
        // U1 = HMAC(password, salt || INT(1))
        var i = 0;
        while i < n {
            work[i] = base[i];
            i = i + 1;
        }
        hmac.update(32, work, salt);
        hmac.update(32, work, one);
        hmac.final(32, work, u);
        i = 0;
        while i < 32 {
            acc[i] = u[i];
            i = i + 1;
        }
        var it = 1;
        while it < iterations {
            i = 0;
            while i < n {
                work[i] = base[i];
                i = i + 1;
            }
            hmac.update(32, work, u);
            hmac.final(32, work, u);
            i = 0;
            while i < 32 {
                acc[i] = byte_of(int_of(acc[i]) ^ int_of(u[i]));
                i = i + 1;
            }
            it = it + 1;
        }
        i = 0;
        while i < 32 {
            dk[i] = acc[i];
            i = i + 1;
        }
        // Best effort: the derived key is the secret.
        i = 0;
        while i < 32 {
            acc[i] = byte_of(0);
            u[i] = byte_of(0);
            i = i + 1;
        }
        i = 0;
        while i < n {
            base[i] = 0;
            work[i] = 0;
            i = i + 1;
        }
    }
    return 0;
}
