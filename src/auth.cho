edition 5;

module mqtt.auth;

import std.bytes;
import std.crypto;
import std.hmac;

// `mqtt.auth` -- password hashing for the broker's credential table (design section 7c).
//
// PBKDF2 (RFC 8018 section 5.2) over HMAC-SHA-256, one output block of 32 bytes. `std.hmac` supplies the HMAC; the loop is
// here because `std` has none. The keyed state is built once and copied for every iteration, so an iteration is one
// copy, one update and one final, not a key setup.

pub fn hash_len() -> [] int {
    return 32;
}

// dk[0..32] = PBKDF2-HMAC-SHA256(password, salt, iterations). Answers 0, or -1 when `iterations` is below 1 or `dk` is
// shorter than 32 bytes.
pub fn pbkdf2_sha256[&p, &s, &d](password: &p [byte], salt: &s [byte], iterations: int, dk: &!d [byte]) -> [] int {
    if iterations < 1 || len(dk) < 32 {
        return -1;
    }
    let n = hmac.state_len(32);
    region r {
        let base = alloc_slice[r](n, 0);
        let work = alloc_slice[r](n, 0);
        hmac.init(32, base, password);
        let one = alloc_slice[r](4, byte_of(0));
        one[3] = byte_of(1);
        let u = alloc_slice[r](32, byte_of(0));
        let acc = alloc_slice[r](32, byte_of(0));
        // U1 = HMAC(password, salt || INT(1))
        var i = 0;
        while i < n {
            work[i] = base[i];
            i = i + 1;
        }
        hmac.update(32, work, salt);
        hmac.update(32, work, one);
        hmac.final(32, work, u);
        i = 0;
        while i < 32 {
            acc[i] = u[i];
            i = i + 1;
        }
        var it = 1;
        while it < iterations {
            i = 0;
            while i < n {
                work[i] = base[i];
                i = i + 1;
            }
            hmac.update(32, work, u);
            hmac.final(32, work, u);
            i = 0;
            while i < 32 {
                acc[i] = byte_of(int_of(acc[i]) ^ int_of(u[i]));
                i = i + 1;
            }
            it = it + 1;
        }
        i = 0;
        while i < 32 {
            dk[i] = acc[i];
            i = i + 1;
        }
        // Best effort: the derived key is the secret.
        i = 0;
        while i < 32 {
            acc[i] = byte_of(0);
            u[i] = byte_of(0);
            i = i + 1;
        }
        i = 0;
        while i < n {
            base[i] = 0;
            work[i] = 0;
            i = i + 1;
        }
    }
    return 0;
}

// ---- the credential table (design section 7c) ---------------------------------------------------------------------
//
// Text, one user per line:
//
//     name:pbkdf2-sha256$<iterations>$<salt hex>$<hash hex>
//     name:sha256$<salt hex>$<hash hex>
//
// Parsed once, at start, into two tables sized by `--auth-users`: `abuf`, `stride()` bytes a record (user name, salt,
// hash), and `ameta`, `meta_stride()` ints a record (name length, iterations or 0 for `sha256`, salt length).

pub fn stride() -> [] int {
    return 128;
}

pub fn meta_stride() -> [] int {
    return 3;
}

pub fn max_name() -> [] int {
    return 64;
}

pub fn max_line() -> [] int {
    return 256;
}

pub fn max_iterations() -> [] int {
    return 1000000;
}

// The most input a table of `users` records may take, one byte past which is refused.
pub fn max_input(users: int) -> [] int {
    return users * (max_line() + 1);
}

// Why a table was refused, as the stable name a process error carries.
pub fn reason(code: int) -> [] &static [byte] {
    if code == 1 {
        return "too-many-users";
    }
    if code == 2 {
        return "line-too-long";
    }
    if code == 3 {
        return "bad-user-name";
    }
    if code == 4 {
        return "bad-scheme";
    }
    if code == 5 {
        return "bad-iterations";
    }
    if code == 6 {
        return "bad-salt";
    }
    if code == 7 {
        return "bad-hash";
    }
    if code == 8 {
        return "duplicate-user";
    }
    if code == 9 {
        return "missing-separator";
    }
    return "input-too-large";
}

fn hexv(c: int) -> [] int {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return 0 - 1;
}

// The index of the next `$` in text[at..end], or `end`.
fn dollar[&t](text: &t [byte], at: int, end: int) -> [] int {
    var e = at;
    while e < end && int_of(text[e]) != 36 {
        e = e + 1;
    }
    return e;
}

// Decode the hex in text[a..b] into out[at..], answering the byte count, or -1 for an odd length or a non-hex digit
// (capitals are refused: one spelling).
fn unhex[&t, &o](text: &t [byte], a: int, b: int, out: &!o [byte], at: int) -> [] int {
    if (b - a) % 2 != 0 {
        return 0 - 1;
    }
    var i = a;
    var n = 0;
    while i < b {
        let hi = hexv(int_of(text[i]));
        let lo = hexv(int_of(text[i + 1]));
        if hi < 0 || lo < 0 {
            return 0 - 1;
        }
        out[at + n] = byte_of(hi * 16 + lo);
        n = n + 1;
        i = i + 2;
    }
    return n;
}

// Record `slot` from the line text[pos..end]. 0, or minus the reason.
fn parse_line[&t, &b, &m](text: &t [byte], pos: int, end: int, abuf: &!b [byte], ameta: &!m [int], slot: int, max_users: int) -> [] int {
    if slot >= max_users {
        return 0 - 1;
    }
    var c = pos;
    while c < end && int_of(text[c]) != 58 {
        c = c + 1;
    }
    if c == end {
        return 0 - 9;
    }
    let nl = c - pos;
    if nl < 1 || nl > max_name() {
        return 0 - 3;
    }
    var i = pos;
    while i < c {
        let ch = int_of(text[i]);
        if ch < 32 || ch == 127 {
            return 0 - 3;
        }
        i = i + 1;
    }
    var j = 0;
    while j < slot {
        if ameta[j * 3] == nl && bytes.equal(text[pos..c], abuf[j * 128..j * 128 + nl]) {
            return 0 - 8;
        }
        j = j + 1;
    }
    let s0 = c + 1;
    let e0 = dollar(text, s0, end);
    var iters = 0;
    var f = e0 + 1;
    if bytes.equal(text[s0..e0], "pbkdf2-sha256") {
        if e0 >= end {
            return 0 - 5;
        }
        let e1 = dollar(text, f, end);
        if e1 - f < 1 || e1 - f > 7 {
            return 0 - 5;
        }
        var k = f;
        while k < e1 {
            let d = int_of(text[k]);
            if d < 48 || d > 57 {
                return 0 - 5;
            }
            iters = iters * 10 + (d - 48);
            k = k + 1;
        }
        if iters < 1 || iters > max_iterations() {
            return 0 - 5;
        }
        f = e1 + 1;
    } else if !bytes.equal(text[s0..e0], "sha256") {
        return 0 - 4;
    }
    if e0 >= end {
        return 0 - 6;
    }
    let es = dollar(text, f, end);
    if es - f < 16 || es - f > 64 {
        return 0 - 6;
    }
    let base = slot * 128;
    var n = 0;
    while n < nl {
        abuf[base + n] = text[pos + n];
        n = n + 1;
    }
    let sl = unhex(text, f, es, abuf, base + 64);
    if sl < 0 {
        return 0 - 6;
    }
    if es >= end {
        return 0 - 7;
    }
    let hs = es + 1;
    let eh = dollar(text, hs, end);
    if eh - hs != 64 || unhex(text, hs, eh, abuf, base + 96) != 32 {
        return 0 - 7;
    }
    if eh != end {
        return 0 - 4;
    }
    ameta[slot * 3] = nl;
    ameta[slot * 3 + 1] = iters;
    ameta[slot * 3 + 2] = sl;
    return 0;
}

// Parse the table `text` into `abuf` and `ameta` (room for `max_users` records each). Answers the number of users, or -1
// with `info[0]` the line and `info[1]` the reason code; on success `info[2]` is the highest iteration count in the table
// (at least 1), the cost an unknown user is made to pay. A blank line is skipped; a final line needs no newline.
pub fn parse[&t, &b, &m, &o](text: &t [byte], abuf: &!b [byte], ameta: &!m [int], max_users: int, info: &!o [int]) -> [] int {
    info[0] = 0;
    info[1] = 0;
    info[2] = 1;
    var pos = 0;
    var line = 0;
    var users = 0;
    while pos < len(text) {
        var e = pos;
        while e < len(text) && int_of(text[e]) != 10 {
            e = e + 1;
        }
        line = line + 1;
        var end = e;
        if end > pos && int_of(text[end - 1]) == 13 {
            end = end - 1;
        }
        if end > pos {
            var r = 0;
            if end - pos > max_line() {
                r = 0 - 2;
            } else {
                r = parse_line(text, pos, end, abuf, ameta, users, max_users);
            }
            if r < 0 {
                info[0] = line;
                info[1] = 0 - r;
                return 0 - 1;
            }
            if ameta[users * 3 + 1] > info[2] {
                info[2] = ameta[users * 3 + 1];
            }
            users = users + 1;
        }
        pos = e + 1;
    }
    return users;
}

// The record for user name `name`, or -1.
pub fn find[&b, &m, &n](abuf: &b [byte], ameta: &m [int], users: int, name: &n [byte]) -> [] int {
    var j = 0;
    while j < users {
        let nl = ameta[j * 3];
        if nl == len(name) && bytes.equal(name, abuf[j * 128..j * 128 + nl]) {
            return j;
        }
        j = j + 1;
    }
    return 0 - 1;
}

// Iterations of work checking a login costs: the record's, 1 for a `sha256` record, `dummy` for a user not in the table.
pub fn cost[&m](ameta: &m [int], idx: int, dummy: int) -> [] int {
    if idx < 0 {
        return dummy;
    }
    if ameta[idx * 3 + 1] > 0 {
        return ameta[idx * 3 + 1];
    }
    return 1;
}

// True when `password` is the one record `idx` holds. For `idx` -1 (an unknown user) it does the work of a record with
// `dummy` iterations and answers false. The comparison reads all 32 bytes whatever they are.
pub fn verify[&b, &m, &p](abuf: &b [byte], ameta: &m [int], idx: int, password: &p [byte], dummy: int) -> [] bool {
    var same = false;
    region r {
        let dk = alloc_slice[r](32, byte_of(0));
        let want = alloc_slice[r](32, byte_of(0));
        if idx >= 0 {
            let base = idx * 128;
            let sl = ameta[idx * 3 + 2];
            let iters = ameta[idx * 3 + 1];
            var i = 0;
            while i < 32 {
                want[i] = abuf[base + 96 + i];
                i = i + 1;
            }
            if iters > 0 {
                pbkdf2_sha256(password, abuf[base + 64..base + 64 + sl], iters, dk);
            } else {
                let st = alloc_slice[r](crypto.sha256_state_len(), 0);
                crypto.sha256_init(st);
                crypto.sha256_update(st, abuf[base + 64..base + 64 + sl]);
                crypto.sha256_update(st, password);
                crypto.sha256_final(st, dk);
            }
        } else {
            let salt = alloc_slice[r](16, byte_of(0));
            pbkdf2_sha256(password, salt, dummy, dk);
        }
        var diff = 0;
        var i = 0;
        while i < 32 {
            diff = diff | int_of(dk[i]) ^ int_of(want[i]);
            dk[i] = byte_of(0);
            i = i + 1;
        }
        same = diff == 0 && idx >= 0;
    }
    return same;
}
