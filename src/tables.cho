edition 5;

// `mqtt.tables` -- the broker's tables, sized once at `open`, and what is done to
// them that does not touch a socket: sessions and the client-id index, the
// per-session outbound queues, the retained store, counters and the refusal
// events the log reads (design sections 4, 6, 7, 8).
//
// Nothing here allocates after `open`. A table that is full answers a code and
// changes nothing; the caller counts the rule.
//
// Per connection `k`, `cs[16k..16k+16]` is:
//
//      0  1 if the slot is in use
//      1  bytes of input buffered
//      2  the time of its last input, in seconds
//      3  its session, or -1 before CONNECT
//      4  keepalive in seconds, 0 for none
//      5  what it is watched for (1 read, 2 write, 3 both)
//      6  bytes of the buffer already handled, this visit
//      7  when it was accepted, in seconds
//      8  1 if it is to close once its output has gone
//      9  since when it has had output it could not send, in seconds, or 0
//     10  1 if it is in `dirty`
//     11  how many connections have used this slot
//
// Per session `s`, `ss[20s..20s+20]` is:
//
//      0  1 if in use
//      1  its connection, or -1 when it is offline
//      2  1 if the client asked for a clean session
//      3  length of its client identifier
//      4  hash of the identifier
//      5  next session in the identifier's hash chain
//      6  queue: offset of the first entry
//      7  queue: offset after the last entry
//      8  queue: offset of the next entry to send
//      9  queue: bytes of that entry already handed to the kernel
//     10  queue: messages held (queued or awaiting acknowledgement)
//     11  queue: QoS 1 messages sent and not acknowledged
//     12  last packet identifier used
//     13  1 if it has a will
//     14  will QoS
//     15  when it last had a connection, in seconds
//     16  will topic length
//     17  will message length
//     18  will retain flag
//     19  next free session
//
// A queue is a run of entries, each `[length:4][state:1][kind:1][pid:2][packet]`;
// state is 0 not yet sent, 1 sent and awaiting acknowledgement, 2 finished; kind
// is 0 a QoS 0 message, 1 a QoS 1 message, 2 a QoS 2 message, 3 a control packet,
// 4 a PUBREL (design section 7a).

module mqtt.tables;

import mqtt.config;
import mqtt.rules;
import mqtt.subs;
import mqtt.topic;
import mqtt.wire;

pub fn c_stride() -> [] int {
    return 16;
}

pub fn s_stride() -> [] int {
    return 21;
}

// Counters not tied to a rule, in `ctr` after the rules'.
pub fn k_publishes() -> [] int {
    return 32;
}

pub fn k_delivered() -> [] int {
    return 33;
}

pub fn k_connects() -> [] int {
    return 34;
}

pub fn k_disconnects() -> [] int {
    return 35;
}

pub fn k_retained_sent() -> [] int {
    return 36;
}

pub fn k_offline_dropped() -> [] int {
    return 37;
}

pub fn k_takeovers() -> [] int {
    return 38;
}

// What `$SYS` reports (design section 7b): socket bytes and MQTT packets each way, PUBLISH
// packets and payload bytes received from clients, payload bytes queued to them, and the
// most sessions (online and offline) there have been at once. Publishes queued to a
// subscriber are `k_delivered`; those it refused are the `limit.queue` rule's counter.
pub fn k_bytes_in() -> [] int {
    return 39;
}

pub fn k_bytes_out() -> [] int {
    return 40;
}

pub fn k_pkts_in() -> [] int {
    return 41;
}

pub fn k_pkts_out() -> [] int {
    return 42;
}

pub fn k_pub_in() -> [] int {
    return 43;
}

pub fn k_pub_in_bytes() -> [] int {
    return 44;
}

pub fn k_pub_out_bytes() -> [] int {
    return 45;
}

pub fn k_clients_max() -> [] int {
    return 46;
}

// `ctr[64 + rule]` is the second (plus one) in which the rule last left an event.
// Bytes one write may carry: the queued messages of a subscriber are copied here, back to
// back and without their entry headers, so one write sends many of them.
pub fn stage_bytes() -> [] int {
    return 65536;
}

pub fn counters() -> [] int {
    return 128;
}

// Events the log has not read yet: a ring of this many; a flood overwrites the
// oldest, and the counters still count every one.
pub fn event_capacity() -> [] int {
    return 128;
}

// Bytes of a client identifier kept with an event.
pub fn event_text() -> [] int {
    return 32;
}

// Room kept free in every queue for control packets (SUBACK and the like), so a
// full queue of messages cannot make an acknowledgement impossible.
fn reserve_bytes() -> [] int {
    return 256;
}

pub res struct Core {
    poller: Poller,
    events: Box[[int]],
    cs: Box[[int]],
    inbuf: Box[[byte]],
    ss: Box[[int]],
    sid: Box[[byte]],
    qbuf: Box[[byte]],
    wbuf: Box[[byte]],
    idb: Box[[int]],
    rt: Box[[int]],
    rtext: Box[[byte]],
    trie: subs.Subs,
    ct: Box[[int]],
    pt: Box[[int]],
    ft: Box[[int]],
    codes: Box[[int]],
    dirty: Box[[int]],
    ctr: Box[[int]],
    evq: Box[[int]],
    evtext: Box[[byte]],
    foreign: Box[[int]],
    stage: Box[[byte]],
    spill: Box[[int]],
    qfree: Box[[int]],
    q2in: Box[[int]],
    q2max: int,
    free_spill: int,
    free_q: int,
    limit: int,
    pmax: int,
    qbytes: int,
    qmsgs: int,
    window: int,
    nsess: int,
    noffline: int,
    idmax: int,
    topic_max: int,
    levels_max: int,
    nret: int,
    rslot: int,
    will_max: int,
    connect_to: int,
    stall_to: int,
    free_sess: int,
    online: int,
    offline: int,
    retained_used: int,
    ndirty: int,
    ev_head: int,
    ev_count: int,
    now: int,
    now_ms: int,
    last_sweep: int,
    auto_id: int,
    nforeign: int,
    start_ms: int,
    sys_every: int,
    sys_last: int,
    aon: int,
    abuf: Box[[byte]],
    ameta: Box[[int]],
    ausers: int,
    adummy: int,
    abudget: int,
    aspent: int,
    awin: int,
    dead: Box[[int]],
}

// All the tables, for the bounds in `cfg` (indexed by `config.i_*`). The poller
// is the caller's; the broker owns it from here.
pub fn open[&h, &g](heap: &!h Heap, poller: Poller, cfg: &g [int], abuf: Box[[byte]], ameta: Box[[int]], ausers: int, adummy: int) -> [heap] Core {
    let limit = cfg[config.i_connections()];
    let pmax = cfg[config.i_packet()];
    let qbytes = cfg[config.i_queue_bytes()];
    let noffline = cfg[config.i_offline()];
    let nsess = limit + noffline;
    let idmax = cfg[config.i_client_id()];
    let will_max = cfg[config.i_will()];
    let nret = cfg[config.i_retained()];
    let rslot = cfg[config.i_retained_slot()];
    var ss = box_slice(heap, s_stride() * nsess, 0);
    // Every session slot starts on the free list.
    borrow mut ss as &!sb in {
        let sd = contents(sb);
        var i = 0;
        while i < nsess {
            sd[s_stride() * i + 1] = 0 - 1;
            sd[s_stride() * i + 5] = 0 - 1;
            sd[s_stride() * i + 20] = 0 - 1;
            sd[s_stride() * i + 19] = i + 1;
            if i + 1 == nsess {
                sd[s_stride() * i + 19] = 0 - 1;
            }
            i = i + 1;
        }
    }
    var cs = box_slice(heap, c_stride() * limit, 0);
    borrow mut cs as &!cb in {
        let cd = contents(cb);
        var i = 0;
        while i < limit {
            cd[c_stride() * i + 3] = 0 - 1;
            cd[c_stride() * i + 12] = 0 - 1;
            i = i + 1;
        }
    }
    // Free lists of the lazily attached buffers: one entry per slot, each pointing
    // at the next, the last at -1.
    var spill = box_slice(heap, limit, 0);
    borrow mut spill as &!pb in {
        let pd = contents(pb);
        var i = 0;
        while i < limit {
            pd[i] = i + 1;
            i = i + 1;
        }
        pd[limit - 1] = 0 - 1;
    }
    var qfree = box_slice(heap, nsess, 0);
    borrow mut qfree as &!qb in {
        let qd = contents(qb);
        var i = 0;
        while i < nsess {
            qd[i] = i + 1;
            i = i + 1;
        }
        qd[nsess - 1] = 0 - 1;
    }
    let trie = subs.open(heap, cfg[config.i_nodes()], cfg[config.i_subs_total()], nsess, cfg[config.i_levels()], cfg[config.i_subs_client()]);
    return Core { poller: poller, events: box_slice(heap, 128, 0), cs: cs, inbuf: box_slice(heap, (limit + 1) * pmax, byte_of(0)), ss: ss, sid: box_slice(heap, nsess * idmax, byte_of(0)), qbuf: box_slice(heap, nsess * qbytes, byte_of(0)), wbuf: box_slice(heap, nsess * will_max, byte_of(0)), idb: box_slice(heap, 2 * nsess + 1, 0 - 1), rt: box_slice(heap, 4 * nret, 0), rtext: box_slice(heap, nret * rslot, byte_of(0)), trie: trie, ct: box_slice(heap, wire.connect_slots(), 0), pt: box_slice(heap, wire.publish_slots(), 0), ft: box_slice(heap, wire.filter_slots(), 0), codes: box_slice(heap, wire.max_filters(), 0), dirty: box_slice(heap, 2 * limit + 8, 0), ctr: box_slice(heap, counters(), 0), evq: box_slice(heap, 6 * event_capacity(), 0), evtext: box_slice(heap, event_text() * event_capacity(), byte_of(0)), foreign: box_slice(heap, 32, 0), stage: box_slice(heap, stage_bytes(), byte_of(0)), spill: spill, qfree: qfree, q2in: box_slice(heap, nsess * cfg[config.i_qos2_inbound()], 0), q2max: cfg[config.i_qos2_inbound()], free_spill: 0, free_q: 0, limit: limit, pmax: pmax, qbytes: qbytes, qmsgs: cfg[config.i_queue_messages()], window: cfg[config.i_inflight()], nsess: nsess, noffline: noffline, idmax: idmax, topic_max: cfg[config.i_topic_max()], levels_max: cfg[config.i_levels()], nret: nret, rslot: rslot, will_max: will_max, connect_to: cfg[config.i_connect_timeout()], stall_to: cfg[config.i_write_stall()], free_sess: 0, online: 0, offline: 0, retained_used: 0, ndirty: 0, ev_head: 0, ev_count: 0, now: 0, now_ms: 0, last_sweep: 0, auto_id: 0, nforeign: 0, start_ms: 0, sys_every: cfg[config.i_sys_interval()], sys_last: 0, aon: cfg[config.i_auth()], abuf: abuf, ameta: ameta, ausers: ausers, adummy: adummy, abudget: cfg[config.i_auth_budget()], aspent: 0, awin: 0 - 1, dead: box_slice(heap, 2 * limit + 2, 0) };
}

pub fn drop[&h](heap: &!h Heap, core: Core) -> [heap] int {
    let Core { poller, events, cs, inbuf, ss, sid, qbuf, wbuf, idb, rt, rtext, trie, ct, pt, ft, codes, dirty, ctr, evq, evtext, foreign, stage, spill, qfree, q2in, q2max, free_spill, free_q, limit, pmax, qbytes, qmsgs, window, nsess, noffline, idmax, topic_max, levels_max, nret, rslot, will_max, connect_to, stall_to, free_sess, online, offline, retained_used, ndirty, ev_head, ev_count, now, now_ms, last_sweep, auto_id, nforeign, start_ms, sys_every, sys_last, aon, abuf, ameta, ausers, adummy, abudget, aspent, awin, dead } = core;
    poller_close(poller);
    unbox_slice(heap, events);
    unbox_slice(heap, cs);
    unbox_slice(heap, inbuf);
    unbox_slice(heap, ss);
    unbox_slice(heap, sid);
    unbox_slice(heap, qbuf);
    unbox_slice(heap, wbuf);
    unbox_slice(heap, idb);
    unbox_slice(heap, rt);
    unbox_slice(heap, rtext);
    subs.drop(heap, trie);
    unbox_slice(heap, ct);
    unbox_slice(heap, pt);
    unbox_slice(heap, ft);
    unbox_slice(heap, codes);
    unbox_slice(heap, dirty);
    unbox_slice(heap, ctr);
    unbox_slice(heap, evq);
    unbox_slice(heap, evtext);
    unbox_slice(heap, foreign);
    unbox_slice(heap, stage);
    unbox_slice(heap, spill);
    unbox_slice(heap, qfree);
    unbox_slice(heap, q2in);
    unbox_slice(heap, abuf);
    unbox_slice(heap, ameta);
    unbox_slice(heap, dead);
    return 0;
}

// ---- counters and events -------------------------------------------------

pub fn bump[&c](core: &!c Core, i: int) -> [] int {
    let ctr = contents(core.ctr);
    ctr[i] = ctr[i] + 1;
    return 0;
}

// Add `n` to counter `i`.
pub fn add[&c](core: &!c Core, i: int, n: int) -> [] int {
    let ctr = contents(core.ctr);
    ctr[i] = ctr[i] + n;
    return 0;
}

pub fn counter[&c](core: &c Core, i: int) -> [] int {
    return contents(core.ctr)[i];
}

// A rule fired for connection `k` / session `s` (either may be -1): count it and
// leave an event for the log, with the start of the client identifier.
pub fn refuse[&c](core: &!c Core, rule: int, k: int, s: int, extra: int) -> [] int {
    bump(core, rule);
    // The count is exact; the event is left once a second per rule. A flood of one rule
    // (a full queue refusing every message to a hundred subscribers) must cost a
    // counter, not an event each: the log says how many it held back from the counter.
    let ctr = contents(core.ctr);
    let second = core.now_ms / 1000 + 1;
    if ctr[64 + rule] == second {
        return 0;
    }
    ctr[64 + rule] = second;
    let cap = event_capacity();
    if core.ev_count == cap {
        core.ev_head = (core.ev_head + 1) % cap;
        core.ev_count = core.ev_count - 1;
    }
    let at = (core.ev_head + core.ev_count) % cap;
    let ev = contents(core.evq);
    ev[6 * at] = rule;
    ev[6 * at + 1] = k;
    ev[6 * at + 2] = core.now_ms;
    ev[6 * at + 3] = s;
    ev[6 * at + 4] = extra;
    var idlen = 0;
    if s >= 0 {
        idlen = contents(core.ss)[s_stride() * s + 3];
        ev[6 * at + 4] = idlen;
        if idlen > event_text() {
            idlen = event_text();
        }
        let tx = contents(core.evtext);
        let ids = contents(core.sid);
        var i = 0;
        while i < idlen {
            tx[at * event_text() + i] = ids[s * core.idmax + i];
            i = i + 1;
        }
    }
    ev[6 * at + 5] = idlen;
    core.ev_count = core.ev_count + 1;
    return 0;
}

// Events waiting, and the fields of the oldest.
pub fn events_waiting[&c](core: &c Core) -> [] int {
    return core.ev_count;
}

pub fn event_field[&c](core: &c Core, field: int) -> [] int {
    return contents(core.evq)[6 * core.ev_head + field];
}

pub fn event_id[&c](core: &c Core) -> [] &c [byte] {
    let at = core.ev_head;
    let n = contents(core.evq)[6 * at + 5];
    return contents(core.evtext)[at * event_text()..at * event_text() + n];
}

pub fn event_pop[&c](core: &!c Core) -> [] int {
    if core.ev_count > 0 {
        core.ev_head = (core.ev_head + 1) % event_capacity();
        core.ev_count = core.ev_count - 1;
    }
    return 0;
}

// ---- sessions ------------------------------------------------------------

fn id_hash[&t](text: &t [byte]) -> [] int {
    var h = 5381;
    var i = 0;
    while i < len(text) {
        h = (h * 33 + int_of(text[i])) % 1000000007;
        i = i + 1;
    }
    return h;
}

pub fn client_id[&c](core: &c Core, s: int) -> [] &c [byte] {
    let n = contents(core.ss)[s_stride() * s + 3];
    return contents(core.sid)[s * core.idmax..s * core.idmax + n];
}

// The session with client identifier `id`, or -1.
pub fn find_session[&c, &i](core: &c Core, id: &i [byte]) -> [] int {
    let sd = contents(core.ss);
    let ids = contents(core.sid);
    let bk = contents(core.idb);
    let h = id_hash(id);
    var s = bk[h % len(bk)];
    while s >= 0 {
        let p = s_stride() * s;
        if sd[p + 4] == h && sd[p + 3] == len(id) {
            var same = true;
            var i = 0;
            while i < len(id) {
                if int_of(ids[s * core.idmax + i]) != int_of(id[i]) {
                    same = false;
                }
                i = i + 1;
            }
            if same {
                return s;
            }
        }
        s = sd[p + 5];
    }
    return 0 - 1;
}

// A fresh session for `id` (at most `idmax` bytes; not already registered), with
// an empty queue and no subscriptions. -1 if the table is full.
pub fn new_session[&c, &i](core: &!c Core, id: &i [byte], clean: int, now: int) -> [] int {
    let s = core.free_sess;
    if s < 0 {
        return 0 - 1;
    }
    let sd = contents(core.ss);
    let ids = contents(core.sid);
    let bk = contents(core.idb);
    let p = s_stride() * s;
    core.free_sess = sd[p + 19];
    let h = id_hash(id);
    let b = h % len(bk);
    sd[p] = 1;
    sd[p + 1] = 0 - 1;
    sd[p + 2] = clean;
    sd[p + 3] = len(id);
    sd[p + 4] = h;
    sd[p + 5] = bk[b];
    sd[p + 6] = 0;
    sd[p + 7] = 0;
    sd[p + 8] = 0;
    sd[p + 9] = 0;
    sd[p + 10] = 0;
    sd[p + 11] = 0;
    sd[p + 12] = 0;
    sd[p + 13] = 0;
    sd[p + 14] = 0;
    sd[p + 15] = now;
    sd[p + 16] = 0;
    sd[p + 17] = 0;
    sd[p + 18] = 0;
    bk[b] = s;
    copy_into(ids[s * core.idmax..(s + 1) * core.idmax], id);
    q2_clear(core, s);
    return s;
}

// Forget session `s`: its subscriptions, its queue, its place in the index.
pub fn free_session[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let bk = contents(core.idb);
    let p = s_stride() * s;
    subs.remove_session(core.trie, s);
    let b = sd[p + 4] % len(bk);
    if bk[b] == s {
        bk[b] = sd[p + 5];
    } else {
        var at = bk[b];
        while at >= 0 && sd[s_stride() * at + 5] != s {
            at = sd[s_stride() * at + 5];
        }
        if at >= 0 {
            sd[s_stride() * at + 5] = sd[p + 5];
        }
    }
    q_give(core, s);
    q2_clear(core, s);
    sd[p] = 0;
    sd[p + 1] = 0 - 1;
    sd[p + 3] = 0;
    sd[p + 19] = core.free_sess;
    core.free_sess = s;
    return 0;
}

// ---- QoS 2 messages received and not yet released ------------------------

// Session `s`'s set of packet identifiers of QoS 2 PUBLISHes it has accepted and
// whose PUBREL has not arrived (design section 7a, method A): `q2max` slots, 0 is
// an empty one.
pub fn q2_has[&c](core: &c Core, s: int, pid: int) -> [] bool {
    let t = contents(core.q2in);
    var i = 0;
    while i < core.q2max {
        if t[s * core.q2max + i] == pid {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Remember `pid` for session `s`. False when the set is full.
pub fn q2_add[&c](core: &!c Core, s: int, pid: int) -> [] bool {
    let t = contents(core.q2in);
    var i = 0;
    while i < core.q2max {
        if t[s * core.q2max + i] == 0 {
            t[s * core.q2max + i] = pid;
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Forget `pid` for session `s` (a PUBREL arrived). True if it was remembered.
pub fn q2_del[&c](core: &!c Core, s: int, pid: int) -> [] bool {
    let t = contents(core.q2in);
    var i = 0;
    while i < core.q2max {
        if t[s * core.q2max + i] == pid {
            t[s * core.q2max + i] = 0;
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn q2_clear[&c](core: &!c Core, s: int) -> [] int {
    let t = contents(core.q2in);
    var i = 0;
    while i < core.q2max {
        t[s * core.q2max + i] = 0;
        i = i + 1;
    }
    return 0;
}

// ---- queues --------------------------------------------------------------

fn get32[&q](q: &q [byte], at: int) -> [] int {
    return int_of(q[at]) << 24 | int_of(q[at + 1]) << 16 | int_of(q[at + 2]) << 8 | int_of(q[at + 3]);
}

fn put32[&q](q: &!q [byte], at: int, v: int) -> [] int {
    q[at] = byte_of(v >> 24 & 255);
    q[at + 1] = byte_of(v >> 16 & 255);
    q[at + 2] = byte_of(v >> 8 & 255);
    q[at + 3] = byte_of(v & 255);
    return 0;
}

// Session `s`'s queue, as a slice of the slab.
// A queue holds a buffer only while it has entries (`q_take` and `q_give`); an
// empty one answers an empty slice.
pub fn queue[&c](core: &!c Core, s: int) -> [] &!c [byte] {
    let q = contents(core.ss)[s_stride() * s + 20];
    if q < 0 {
        return contents(core.qbuf)[0..0];
    }
    return contents(core.qbuf)[q * core.qbytes..(q + 1) * core.qbytes];
}

pub fn queue_view[&c](core: &c Core, s: int) -> [] &c [byte] {
    let q = contents(core.ss)[s_stride() * s + 20];
    if q < 0 {
        return contents(core.qbuf)[0..0];
    }
    return contents(core.qbuf)[q * core.qbytes..(q + 1) * core.qbytes];
}

// Give session `s` a buffer from the pool (there are as many as sessions, so one
// is always free for a session without one). The most recently freed is reused
// first, so the pages a broker touches are those of its busiest moment, not of
// its connection count.
fn q_take[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    if sd[p + 20] >= 0 {
        return 0;
    }
    let q = core.free_q;
    if q < 0 {
        return 0 - 1;
    }
    core.free_q = contents(core.qfree)[q];
    sd[p + 20] = q;
    return 0;
}

// Return session `s`'s buffer to the pool; the queue must be empty.
fn q_give[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = sd[p + 20];
    if q >= 0 {
        contents(core.qfree)[q] = core.free_q;
        core.free_q = q;
        sd[p + 20] = 0 - 1;
    }
    return 0;
}

// Connection `k`'s spill slot (the input of a packet still arriving, see
// `broker.process_input`): its offset in `inbuf`, taking a slot if it has none.
// Slot 0 of `inbuf` is the scratch every read lands in.
pub fn spill_take[&c](core: &!c Core, k: int) -> [] int {
    let cd = contents(core.cs);
    let p = c_stride() * k;
    if cd[p + 12] < 0 {
        let n = core.free_spill;
        if n < 0 {
            return 0 - 1;
        }
        core.free_spill = contents(core.spill)[n];
        cd[p + 12] = n;
    }
    return (cd[p + 12] + 1) * core.pmax;
}

pub fn spill_give[&c](core: &!c Core, k: int) -> [] int {
    let cd = contents(core.cs);
    let p = c_stride() * k;
    let n = cd[p + 12];
    if n >= 0 {
        contents(core.spill)[n] = core.free_spill;
        core.free_spill = n;
        cd[p + 12] = 0 - 1;
    }
    return 0;
}

// Empty session `s`'s queue.
pub fn q_reset[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    sd[p + 6] = 0;
    sd[p + 7] = 0;
    sd[p + 8] = 0;
    sd[p + 9] = 0;
    sd[p + 10] = 0;
    sd[p + 11] = 0;
    q_give(core, s);
    return 0;
}

// Make room for a packet of `size` bytes in session `s`'s queue: the offset the
// packet is to be written at, or -1. A message (not a control packet) is refused
// when the queue holds its message limit or would use the room kept for control
// packets. Whole entries only: the caller writes the packet there and calls
// `q_commit`.
pub fn q_reserve[&c](core: &!c Core, s: int, size: int, message: bool) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    if message && sd[p + 10] >= core.qmsgs {
        return 0 - 1;
    }
    var room = core.qbytes;
    if message {
        room = core.qbytes - reserve_bytes();
    }
    let need = 8 + size;
    if need > room {
        return 0 - 1;
    }
    if sd[p + 7] + need > room {
        // Slide the live entries down over what has finished.
        let head = sd[p + 6];
        if head > 0 {
            let q = queue(core, s);
            copy_within(q, 0, head, sd[p + 7] - head);
            sd[p + 7] = sd[p + 7] - head;
            sd[p + 8] = sd[p + 8] - head;
            sd[p + 6] = 0;
        }
        if sd[p + 7] + need > room {
            return 0 - 1;
        }
    }
    if q_take(core, s) != 0 {
        return 0 - 1;
    }
    return sd[p + 7] + 8;
}

// The packet of `size` bytes written at the offset `q_reserve` answered is now an
// entry of `kind` with packet identifier `pid`.
pub fn q_commit[&c](core: &!c Core, s: int, at: int, size: int, kind: int, pid: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue(core, s);
    put32(q, at - 8, size);
    q[at - 4] = byte_of(0);
    q[at - 3] = byte_of(kind);
    q[at - 2] = byte_of(pid / 256);
    q[at - 1] = byte_of(pid % 256);
    sd[p + 7] = at + size;
    if kind < 3 {
        sd[p + 10] = sd[p + 10] + 1;
    }
    return 0;
}

// The first entry's packet identifier in use? (Scans the queue.)
fn pid_in_use[&c](core: &c Core, s: int, pid: int) -> [] bool {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue_view(core, s);
    var at = sd[p + 6];
    while at < sd[p + 7] {
        let kind = int_of(q[at + 5]);
        if (kind == 1 || kind == 2 || kind == 4) && int_of(q[at + 4]) < 2 && int_of(q[at + 6]) * 256 + int_of(q[at + 7]) == pid {
            return true;
        }
        at = at + 8 + get32(q, at);
    }
    return false;
}

// The next packet identifier for session `s`, 1 to 65535, not in use by a message
// still in its queue.
pub fn q_pid[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    var pid = sd[p + 12];
    var tries = 0;
    while tries < 70000 {
        pid = pid % 65535 + 1;
        if !pid_in_use(core, s, pid) {
            sd[p + 12] = pid;
            return pid;
        }
        tries = tries + 1;
    }
    return 0;
}

// A PUBACK for `pid` arrived: finish that message. True if one was awaiting it.
pub fn q_ack[&c](core: &!c Core, s: int, pid: int) -> [] bool {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue(core, s);
    var at = sd[p + 6];
    while at < sd[p + 7] {
        if int_of(q[at + 5]) == 1 && int_of(q[at + 4]) == 1 && int_of(q[at + 6]) * 256 + int_of(q[at + 7]) == pid {
            q[at + 4] = byte_of(2);
            sd[p + 11] = sd[p + 11] - 1;
            sd[p + 10] = sd[p + 10] - 1;
            return true;
        }
        at = at + 8 + get32(q, at);
    }
    return false;
}

// A PUBREC for `pid` arrived: the QoS 2 message sent under it is finished (its
// identifier now belongs to the PUBREL the caller queues). True if one was
// awaiting it.
pub fn q_rec[&c](core: &!c Core, s: int, pid: int) -> [] bool {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue(core, s);
    var at = sd[p + 6];
    while at < sd[p + 7] {
        if int_of(q[at + 5]) == 2 && int_of(q[at + 4]) == 1 && int_of(q[at + 6]) * 256 + int_of(q[at + 7]) == pid {
            q[at + 4] = byte_of(2);
            sd[p + 11] = sd[p + 11] - 1;
            sd[p + 10] = sd[p + 10] - 1;
            return true;
        }
        at = at + 8 + get32(q, at);
    }
    return false;
}

// A PUBCOMP for `pid` arrived: finish the PUBREL sent for it. True if one was
// awaiting it.
pub fn q_comp[&c](core: &!c Core, s: int, pid: int) -> [] bool {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue(core, s);
    var at = sd[p + 6];
    while at < sd[p + 7] {
        if int_of(q[at + 5]) == 4 && int_of(q[at + 4]) == 1 && int_of(q[at + 6]) * 256 + int_of(q[at + 7]) == pid {
            q[at + 4] = byte_of(2);
            sd[p + 11] = sd[p + 11] - 1;
            return true;
        }
        at = at + 8 + get32(q, at);
    }
    return false;
}

// Drop finished entries from the front of the queue; an empty queue starts over.
pub fn q_trim[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue(core, s);
    var head = sd[p + 6];
    while head < sd[p + 7] && int_of(q[head + 4]) == 2 && head + 8 + get32(q, head) <= sd[p + 8] {
        head = head + 8 + get32(q, head);
    }
    sd[p + 6] = head;
    if head == sd[p + 7] {
        sd[p + 6] = 0;
        sd[p + 7] = 0;
        sd[p + 8] = 0;
        sd[p + 9] = 0;
        q_give(core, s);
    }
    return 0;
}

// The connection is gone and the session stays: what was sent and not
// acknowledged goes out again with DUP when it is back, QoS 0 messages and control
// packets are dropped (a QoS 0 message is not kept for an absent client).
pub fn q_going_offline[&c](core: &!c Core, s: int) -> [] int {
    let sd = contents(core.ss);
    let p = s_stride() * s;
    let q = queue(core, s);
    var at = sd[p + 6];
    var held = 0;
    while at < sd[p + 7] {
        let size = get32(q, at);
        let kind = int_of(q[at + 5]);
        let state = int_of(q[at + 4]);
        if kind == 0 || kind == 3 {
            q[at + 4] = byte_of(2);
        } else if state == 1 {
            // Sent: it will go again. A message is marked as a duplicate; a PUBREL has no
            // such flag.
            q[at + 4] = byte_of(0);
            if kind != 4 {
                q[at + 8] = byte_of(int_of(q[at + 8]) | 8);
            }
        }
        if int_of(q[at + 4]) < 2 && (kind == 1 || kind == 2) {
            held = held + 1;
        }
        at = at + 8 + size;
    }
    sd[p + 10] = held;
    sd[p + 11] = 0;
    sd[p + 8] = sd[p + 6];
    sd[p + 9] = 0;
    // Everything finished is trimmed: with `send` at the head, trim stops at the
    // first live entry.
    var head = sd[p + 6];
    while head < sd[p + 7] && int_of(q[head + 4]) == 2 {
        head = head + 8 + get32(q, head);
    }
    sd[p + 6] = head;
    sd[p + 8] = head;
    if head == sd[p + 7] {
        sd[p + 6] = 0;
        sd[p + 7] = 0;
        sd[p + 8] = 0;
        q_give(core, s);
    }
    return 0;
}

// ---- retained messages ---------------------------------------------------

// The slot holding a retained message for exactly `name`, or -1.
fn ret_find[&c, &n](core: &c Core, name: &n [byte]) -> [] int {
    let rd = contents(core.rt);
    let tx = contents(core.rtext);
    var i = 0;
    while i < core.nret {
        if rd[4 * i] == 1 && rd[4 * i + 1] == len(name) {
            var same = true;
            var j = 0;
            while j < len(name) {
                if int_of(tx[i * core.rslot + j]) != int_of(name[j]) {
                    same = false;
                }
                j = j + 1;
            }
            if same {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Retain `payload` for `name` at `qos`; an empty payload clears it (3.3.1-5,
// 3.3.1-10). Answers 0, or 1 when it could not be kept (no slot, or the message is
// larger than a slot): the caller counts `limit.retained`. Updates and clears of
// a topic already held never fail.
pub fn ret_set[&c, &n, &p](core: &!c Core, name: &n [byte], payload: &p [byte], qos: int) -> [] int {
    let rd = contents(core.rt);
    let tx = contents(core.rtext);
    let at = ret_find(core, name);
    if len(payload) == 0 {
        if at >= 0 {
            rd[4 * at] = 0;
            core.retained_used = core.retained_used - 1;
        }
        return 0;
    }
    if len(name) + len(payload) > core.rslot {
        return 1;
    }
    var slot = at;
    if slot < 0 {
        var i = 0;
        while i < core.nret && slot < 0 {
            if rd[4 * i] == 0 {
                slot = i;
            }
            i = i + 1;
        }
        if slot < 0 {
            return 1;
        }
        core.retained_used = core.retained_used + 1;
    }
    rd[4 * slot] = 1;
    rd[4 * slot + 1] = len(name);
    rd[4 * slot + 2] = len(payload);
    rd[4 * slot + 3] = qos;
    let base = slot * core.rslot;
    copy_into(tx[base..base + core.rslot], name);
    copy_into(tx[base + len(name)..base + core.rslot], payload);
    return 0;
}

pub fn ret_slots[&c](core: &c Core) -> [] int {
    return core.nret;
}

pub fn ret_used[&c](core: &c Core, i: int) -> [] bool {
    return contents(core.rt)[4 * i] == 1;
}

pub fn ret_qos[&c](core: &c Core, i: int) -> [] int {
    return contents(core.rt)[4 * i + 3];
}

pub fn ret_topic[&c](core: &c Core, i: int) -> [] &c [byte] {
    let base = i * core.rslot;
    return contents(core.rtext)[base..base + contents(core.rt)[4 * i + 1]];
}

pub fn ret_payload[&c](core: &c Core, i: int) -> [] &c [byte] {
    let base = i * core.rslot + contents(core.rt)[4 * i + 1];
    return contents(core.rtext)[base..base + contents(core.rt)[4 * i + 2]];
}
