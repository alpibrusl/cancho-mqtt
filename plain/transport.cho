edition 5;

// `mqtt.transport` -- the plain transport: a connection is a socket (docs/design.md section 7d, step 2).
//
// The broker reaches its connections only through this module, so that a second module of the same name, for TLS, can sit
// in its place in a second binary without a line of `broker.cho` changing. This one is a pass-through to `std.conns`: every
// function does what the `conns` function of the same name does, and nothing else, so that moving the broker onto it is
// measured to change nothing. `Links` is the connection table and, in another transport, whatever else a connection needs.

module mqtt.transport;

import std.conns;

pub res struct Links {
    table: conns.Table,
}

pub fn empty[&h](heap: &!h Heap, capacity: int) -> [heap] Links {
    return Links { table: conns.empty(heap, capacity) };
}

pub fn drop[&h](heap: &!h Heap, net: Links) -> [heap] int {
    let Links { table } = net;
    return conns.drop(heap, table);
}

pub fn live[&n](net: &n Links) -> [] int {
    return conns.live(net.table);
}

pub fn slots[&n](net: &n Links) -> [] int {
    return conns.slots(net.table);
}

// A connection `c` into the table: the grown table and its slot, or -1.
pub fn put[&h](heap: &!h Heap, net: Links, c: Conn) -> [heap] (Links, int) {
    let Links { table } = net;
    let (grown, slot) = conns.put(heap, table, c);
    return (Links { table: grown }, slot);
}

pub fn read[&n, &b](net: &!n Links, slot: int, into: &!b [byte]) -> [conn_read] Received {
    return conns.read(net.table, slot, into);
}

pub fn write[&n, &b](net: &!n Links, slot: int, data: &b [byte]) -> [conn_write] Sent {
    return conns.write(net.table, slot, data);
}

pub fn nonblocking[&n](net: &!n Links, slot: int) -> [] int {
    return conns.nonblocking(net.table, slot);
}

pub fn nodelay[&n](net: &!n Links, slot: int) -> [] int {
    return conns.nodelay(net.table, slot);
}

pub fn watch[&n, &p](net: &!n Links, poller: &!p Poller, slot: int, token: int, events: int) -> [poll] int {
    return conns.watch(net.table, poller, slot, token, events);
}

pub fn rewatch[&n, &p](net: &!n Links, poller: &!p Poller, slot: int, token: int, events: int) -> [poll] int {
    return conns.rewatch(net.table, poller, slot, token, events);
}

pub fn close[&n](net: &!n Links, slot: int) -> [] int {
    return conns.close(net.table, slot);
}
